with "my_sparklib";

project Test is
   for Source_Dirs use (".");
   for Source_Files use
     ("spark-strings.ads", "spark-strings-unicode.ads",
      "spark-strings-unicode-models.ads",
      "spark-strings-unicode-utf_8.ads", "spark-strings-unicode-utf_8.adb");
   for Object_Dir use "obj";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022");
   end Compiler;
end Test;
