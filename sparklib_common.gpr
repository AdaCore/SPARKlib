abstract project SPARKlib_common is

   for Source_Files use ();

   --  Environment variable SPARKLIB_INSTALLED controls whether the
   --  project and its sources are being installed as part of SPARK install
   --  (value "True") or whether they are in source repository configuration
   --  (value "False"). Inside SPARK install, this project file is installed
   --  in <install>/lib/gnat and the sources in <install>/include/spark

   type SPARKlib_Installed_T is ("True", "False");
   SPARKlib_Installed : SPARKlib_Installed_T := External("SPARKLIB_INSTALLED", "True");

   --  Body mode selects executable assertion levels in the root SPARK unit
   --  and a default configuration enabling analysis of library bodies.

   type SPARKlib_Body_Mode_T is ("On", "Off");
   SPARKlib_Body_Mode : SPARKlib_Body_Mode_T :=
     External ("SPARKLIB_BODY_MODE", "Off");

   --  A client can replace the default static switches with its own
   --  sparklib_config.ads. Use an absolute directory name; relative names
   --  are resolved relative to the project files that use them.

   Config_Dir := External ("SPARKLIB_CONFIG_DIR", "");
   Config_Source_Dirs := ();
   Config_File := "sparklib_config.ads";
   case Config_Dir is
      when "" =>
         case SPARKlib_Body_Mode is
            when "On" =>
               Config_File := "sparklib_config__body_mode.ads.in";
            when "Off" =>
               Config_File := "sparklib_config__default.ads.in";
         end case;
      when others =>
         Config_Source_Dirs := (Config_Dir);
   end case;

   --  Only the variants named by Naming are library sources. Projects with
   --  an explicit Source_Files list must include Mode_Source_Files.

   Mode_Source_Files := (Config_File);
   case SPARKlib_Body_Mode is
      when "On" =>
         Mode_Source_Files := Mode_Source_Files & ("spark__exec.ads.in");
      when "Off" =>
         Mode_Source_Files := Mode_Source_Files & ("spark__prove.ads.in");
   end case;

   --  Enforce GNAT style checks, except for multiple blank lines and
   --  alphabetical ordering of subprogram bodies (although not applicable to
   --  null subprograms).
   Common_Default_Switches :=
     ("-gnat2022", "-gnatygo-u",
      "-gnatwI");  --  disable warnings about SPARKlib using GNAT internal units

   Root := "";

   case SPARKlib_Installed is
      when "True" =>
         Root := SPARKlib_common'Project_Dir & "/../../include/spark";
      when others =>
         Root := SPARKlib_common'Project_Dir & "/src";
   end case;

   package Compiler is
      for Default_Switches ("Ada") use Common_Default_Switches;
   end Compiler;

   package Naming is
      for Spec ("SPARKlib_Config") use Config_File;

      case SPARKlib_Body_Mode is
         when "On" =>
            for Spec ("SPARK") use "spark__exec.ads.in";
         when "Off" =>
            for Spec ("SPARK") use "spark__prove.ads.in";
      end case;
   end Naming;

   package Prove is
      for Proof_Dir use "proof";
   end Prove;

end SPARKlib_common;
