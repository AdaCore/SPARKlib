--

--  Variant of the root SPARK unit used in body mode, selected through the
--  SPARKLIB_BODY_MODE external of the library project files. It differs from
--  the regular variant in that no assertion level is static, so that all of
--  them can be executed.

pragma Assertion_Level (SPARKlib_Defensive);
pragma Assertion_Level (SPARKlib_Logic);
pragma Assertion_Level (SPARKlib_Full, Depends => SPARKlib_Logic);
--  Allow execution of SPARKlib_Logic and SPARKlib_Full here for all runtimes

package SPARK
  with SPARK_Mode, Pure
is

end SPARK;
