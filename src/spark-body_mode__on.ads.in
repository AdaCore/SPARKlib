--

--  Body mode is the configuration in which the library bodies, and the
--  private parts they rely on, are analysed instead of being hidden from
--  analysis. The constant below is the static Boolean that all the affected
--  SPARK_Mode pragmas and aspects of the library are written against.
--
--  Two variants of this unit exist, one for each value of the constant. The
--  library project files select between them through the SPARKLIB_BODY_MODE
--  external, so the file names must never be relied upon directly.
--
--  This is the variant that enables body mode.

package SPARK.Body_Mode
  with SPARK_Mode, Pure
is

   Enabled : constant Boolean := True;

end SPARK.Body_Mode;
